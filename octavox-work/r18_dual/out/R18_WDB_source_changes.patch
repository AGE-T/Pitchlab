+//       factory   {3D4CDBC6-ACAC-BB09-077F-D5B80BD2F550}
+//         = sha256("... :: module factory UID for the ObsKernel6
+//                   variant")[0..15]
+//
+// The 38-parameter host surface is IDENTICAL in both variants: no host
