# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# octavox-work regenerable build trees (CMake output; sources + delivery zips are tracked)
octavox-work/r26/source/build_*/
octavox-work/r26/source/vst3/build_*/
# R24-W regenerable cross-build trees + package staging (zips tracked in public/)
octavox-work/r24/build_win_r24w_*/
octavox-work/r24/package/
octavox-work/r24/package_v2/
# R32-W regenerable build trees + package staging (zip tracked in public/)
octavox-work/r26/source/build_r32/
octavox-work/r26/source/build_r32_asan/
octavox-work/r26/source/vst3/build_r32/
octavox-work/r26/source/vst3/build_win_r32/
octavox-work/r32/stage/
# R34 regenerable build trees + package staging (zip tracked in public/)
octavox-work/r34/stage/
# secrets: session tokens uploaded to upload/ are moved to ~/.secrets and must never be committed
upload/token.txt
upload/*_token*
*.token
# CMake try-compile artifact written to the vst3 source dir on every configure
octavox-work/r26/source/vst3/-
